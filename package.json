{
  "name": "atomic-war-2d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot server/index.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "build": "rm -rf dist && NODE_ENV=production bun build ./index.html --outdir dist --production --public-path=/ --env='PUBLIC_*'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "smoke": "bun e2e/smoke.ts",
    "deploy": "bun run build && bunx wrangler pages deploy dist --project-name=atomic-war",
    "pages:dev": "bun run build && bunx wrangler pages dev dist"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
